WANDB_API_KEY=your_wandb_api_key_here
HF_TOKEN=your_huggingface_token_here
WANDB_ENTITY=fyp-team-2513
HF_HOME=/path/to/.cache/huggingface
HF_DATASETS_OFFLINE=0

# SLURM partition — read by scripts/sbatch.sh to select the GPU queue.
# Galvani: a100-galvani  |  Ferranti: h100-ferranti (or h100-preemptable-ferranti)
CLUSTER_PARTITION=a100-galvani

# --------------------------------------------------------------------------- #
# Automatic results publishing (lcm_scripts/results_sync.py)
# --------------------------------------------------------------------------- #
# Every run collects its figures, loss history and full hyperparameter record
# into results/runs/<run_name>/ and commits it. Set this to 1 to also push.
BLT_LCM_PUSH_RESULTS=0

# Credentials for pushing from a compute node, which has no credential helper,
# no ssh agent and no terminal to prompt on.
#
# PUT THE REAL TOKEN IN .env, NEVER IN A TRACKED FILE. .env is gitignored
# (see line 1 of .gitignore); .env.example is not, and anything written here
# would be pushed to GitHub on the first results commit — GitHub scans public
# pushes for tokens and revokes them, so a leaked token breaks the very jobs
# it was added for.
#
# Needs a classic PAT with `repo` scope, or a fine-grained PAT with
# "Contents: read and write" on this repository.
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_personal_access_token

# Optional overrides:
# BLT_LCM_RESULTS_REMOTE=origin       # remote to push to
# BLT_LCM_RESULTS_BRANCH=results      # push results to a dedicated branch
# BLT_LCM_RESULTS_COMMIT_MODE=auto    # auto|isolated|worktree (see scripts.md)
# BLT_LCM_RESULTS_RETRIES=5           # push attempts when jobs race
# BLT_LCM_RESULTS_TIMEOUT=120         # per-git-command timeout, seconds
