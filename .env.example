WANDB_API_KEY=your_wandb_api_key_here
HF_TOKEN=your_huggingface_token_here
WANDB_ENTITY=fyp-team-2513
HF_HOME=/path/to/.cache/huggingface
HF_DATASETS_OFFLINE=0

# SLURM cluster settings — read by scripts/sbatch.sh.
# Galvani: partition=a100-galvani, mem=40G  |  Ferranti: partition=h100-ferranti, mem=80G
CLUSTER_PARTITION=a100-galvani
CLUSTER_MEM=40G

# Path to the Apptainer/Singularity image used by SONAR submission scripts.
# Build once with: bash scripts/build_apptainer.sh
APPTAINER_IMAGE=$HOME/dev/BLT-LCM/lcm-sonar.sif
